# Copia in .env e inserisci le TUE chiavi. Il file .env è in .gitignore: non finisce mai su git.

# --- Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# oppure gemini-3.8-flash-lite-tts (più economico)
TTS_MODEL=gemini-3.8-flash-tts
# "fake" per sviluppare senza consumare crediti
TTS_BACKEND=gemini

# --- Formatter: local | remote | auto | fake
FORMATTER_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
# controlla il nome esatto con: ollama list
OLLAMA_MODEL=qwen3.5:9b

# --- DeepSeek (fallback remoto, API compatibile OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Facoltativo: tracing su LangSmith (vedi ogni passo del grafo in una UI web)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=voce-agenti
